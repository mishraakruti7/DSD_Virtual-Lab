# ==============================================================================
# Virtual DSD Lab (ECCOR2PC203) - Environment Configuration
# ==============================================================================
#
# QUICK START:
# 1. Copy this file to '.env.local':
#    cp .env.example .env.local
#
# 2. Create a free Supabase project at:
#    https://supabase.com
#
# 3. In your Supabase project dashboard:
#    - Navigate to: Project Settings -> API
#    - Copy "Project URL" and paste into VITE_SUPABASE_URL below.
#    - Copy "anon public" key and paste into VITE_SUPABASE_ANON_KEY below.
#
# 4. Run the database migration script:
#    - Open the SQL Editor in your Supabase dashboard.
#    - Copy the contents of 'supabase/schema.sql' from this repo and click RUN.
#
# 5. For the "Ask the DSD Tutor" AI Chatbot (PART B):
#    - Deploy the edge function:
#      supabase functions deploy dsd-tutor
#    - Set your Claude/Anthropic API key securely in Supabase secrets (NEVER in this client file):
#      supabase secrets set ANTHROPIC_API_KEY=sk-ant-api03-...
#
# NOTE: If these variables are not set or left as placeholders, the application
# will automatically run in Offline/Local Mode, allowing full access to all labs,
# simulators, and local progress tracking without crashing.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
